# ---- SCIST Gate environment ----
# Everything here is optional. With nothing set, `pnpm dev` runs on an
# embedded PGlite database, account/password login, mock instances and
# manual video / file IDs. Fill things in as you wire up real services.

# Database. Leave unset for PGlite (stored in .data/pglite).
# DATABASE_URL=postgres://user:pass@host:5432/scist
# PGLITE_DIR=.data/pglite

# Session signing secret (32+ random chars). Required in production.
# AUTH_SECRET=change-me-to-a-long-random-string
# APP_URL=https://gate.scist.org

# Password login is always on. Register as a student; the first account
# becomes admin if the database has none yet. To pin an admin instead:
# ADMIN_HANDLES=yourhandle
# BOOTSTRAP_ADMIN_HANDLE=yourhandle
# BOOTSTRAP_ADMIN_PASSWORD=at-least-8-chars

# Never turn this on in production. Allows /api/auth/dev and /admin?as=…
# ENABLE_DEV_LOGIN=1

# Lets the weekly backup Action read /api/admin/export without a login.
# Same value goes in the repo secret BACKUP_TOKEN. 24+ chars.
# BACKUP_TOKEN=

# Discord OAuth — https://discord.com/developers/applications
# Redirect URI: {APP_URL}/api/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs that become admins on first login
# ADMIN_DISCORD_IDS=123456789012345678
# Webhook that receives new questions and first bloods
# DISCORD_WEBHOOK_URL=

# Cloudflare Stream (video hosting, browser direct upload)
# CF_ACCOUNT_ID=
# CF_STREAM_API_TOKEN=
# CF_STREAM_CUSTOMER_CODE=

# Cloudflare R2 (challenge attachments, presigned upload)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=scist-gate
# R2_PUBLIC_URL=https://files.gate.scist.org

# Instancer service on the VPS (see instancer/README.md)
# INSTANCER_URL=https://instancer.gate.scist.org
# INSTANCER_SECRET=shared-secret

# Seeding. Outside production an empty database is filled with the demo
# content automatically. AUTO_SEED=1 does the same in production (first
# deploy); AUTO_SEED=0 turns it off everywhere.
# AUTO_SEED=1

# Sentry — errors go nowhere until this is set. DSN is safe to expose
# (write-only). Use the same value for both; client needs the NEXT_PUBLIC_ one.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ---- Client-side switches (baked in at build time) ----
# The /admin console talks to /api/admin/* by default. Set "local" to run it
# on browser storage instead (no session needed, changes stay in the browser).
# NEXT_PUBLIC_ADMIN_API=local
# Show the optional "Sign in with Discord" button (needs DISCORD_CLIENT_ID above).
# NEXT_PUBLIC_DISCORD_LOGIN=1
